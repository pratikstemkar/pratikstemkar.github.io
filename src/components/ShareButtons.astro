---
// Share buttons for blog posts - Twitter, LinkedIn, Copy Link
interface Props {
  title: string;
  url: string;
}

const { title, url } = Astro.props;
const encodedTitle = encodeURIComponent(title);
const encodedUrl = encodeURIComponent(url);
---

<div class="flex items-center gap-3 mt-8 pt-6 border-t border-black/10 dark:border-white/10">
  <span class="text-sm text-black/50 dark:text-white/50">Share:</span>
  
  <!-- Twitter/X -->
  <a
    href={`https://twitter.com/intent/tweet?text=${encodedTitle}&url=${encodedUrl}`}
    target="_blank"
    rel="noopener noreferrer"
    class="p-2 rounded-lg hover:bg-black/5 dark:hover:bg-white/5 transition-colors"
    aria-label="Share on Twitter"
  >
    <svg class="w-5 h-5 fill-current opacity-60 hover:opacity-100" viewBox="0 0 24 24">
      <path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z" />
    </svg>
  </a>

  <!-- LinkedIn -->
  <a
    href={`https://www.linkedin.com/sharing/share-offsite/?url=${encodedUrl}`}
    target="_blank"
    rel="noopener noreferrer"
    class="p-2 rounded-lg hover:bg-black/5 dark:hover:bg-white/5 transition-colors"
    aria-label="Share on LinkedIn"
  >
    <svg class="w-5 h-5 fill-current opacity-60 hover:opacity-100" viewBox="0 0 24 24">
      <path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433c-1.144 0-2.063-.926-2.063-2.065 0-1.138.92-2.063 2.063-2.063 1.14 0 2.064.925 2.064 2.063 0 1.139-.925 2.065-2.064 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z" />
    </svg>
  </a>

  <!-- Copy Link -->
  <button
    id="copy-link-btn"
    class="p-2 rounded-lg hover:bg-black/5 dark:hover:bg-white/5 transition-colors relative"
    aria-label="Copy link"
    data-url={url}
  >
    <svg id="copy-icon" class="w-5 h-5 stroke-current opacity-60 hover:opacity-100" fill="none" viewBox="0 0 24 24" stroke-width="2">
      <path stroke-linecap="round" stroke-linejoin="round" d="M13.19 8.688a4.5 4.5 0 011.242 7.244l-4.5 4.5a4.5 4.5 0 01-6.364-6.364l1.757-1.757m9.303-3.244a4.5 4.5 0 00-1.242-7.244l4.5-4.5a4.5 4.5 0 016.364 6.364l-1.757 1.757" />
    </svg>
    <svg id="check-icon" class="w-5 h-5 stroke-current text-green-500 hidden" fill="none" viewBox="0 0 24 24" stroke-width="2">
      <path stroke-linecap="round" stroke-linejoin="round" d="M4.5 12.75l6 6 9-13.5" />
    </svg>
  </button>
</div>

<script is:inline>
  document.getElementById('copy-link-btn')?.addEventListener('click', async function() {
    const url = this.dataset.url;
    const copyIcon = document.getElementById('copy-icon');
    const checkIcon = document.getElementById('check-icon');
    
    try {
      await navigator.clipboard.writeText(url);
      copyIcon?.classList.add('hidden');
      checkIcon?.classList.remove('hidden');
      
      setTimeout(() => {
        copyIcon?.classList.remove('hidden');
        checkIcon?.classList.add('hidden');
      }, 2000);
    } catch (err) {
      console.error('Failed to copy:', err);
    }
  });
</script>
