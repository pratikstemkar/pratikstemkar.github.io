---
import type { CollectionEntry } from "astro:content";

type Props = {
  entry: CollectionEntry<"blog"> | CollectionEntry<"projects">;
  showTags?: boolean;
}

const { entry, showTags = false } = Astro.props;
const tags = 'tags' in entry.data ? entry.data.tags : undefined;
const technologies = 'technologies' in entry.data ? entry.data.technologies : undefined;
const displayTags = tags || technologies;
const isDraft = entry.data.draft;
const Component = isDraft ? "div" : "a";
const href = isDraft ? undefined : `/${entry.collection}/${entry.slug}`;

const date = 'date' in entry.data ? entry.data.date : undefined;
const formattedDate = date
  ? date.toLocaleDateString("en-us", { month: "short", day: "numeric", year: "numeric" })
  : undefined;
---

<Component
  href={href}
  class={`group flex items-start gap-3 py-3 transition-all duration-300 ease-out ${
    isDraft
      ? "cursor-not-allowed opacity-50"
      : "hover:translate-x-1"
  }`}
>
  <!-- Content -->
  <div class="flex flex-col min-w-0 flex-1 gap-0.5">
    <div class="flex items-baseline justify-between gap-3 min-w-0">
      <span class={`font-medium truncate transition-colors duration-300 ${
        isDraft
          ? "text-neutral-500 dark:text-neutral-400"
          : "text-neutral-900 dark:text-white group-hover:text-emerald-600 dark:group-hover:text-emerald-400"
      }`}>
        {entry.data.title}
        {isDraft && (
          <span class="ml-2 inline-block text-[10px] uppercase tracking-wider font-medium px-1.5 py-0.5 rounded bg-neutral-200 dark:bg-neutral-700 text-neutral-400 dark:text-neutral-500">
            Soon
          </span>
        )}
      </span>
      {formattedDate && (
        <time class="flex-shrink-0 text-xs text-neutral-400 dark:text-neutral-500 tabular-nums">
          {formattedDate}
        </time>
      )}
    </div>

    <p class="text-sm text-neutral-500 dark:text-neutral-400 truncate">
      {entry.data.description}
    </p>

    {showTags && displayTags && displayTags.length > 0 && (
      <div class="flex flex-wrap gap-1 mt-1.5">
        {displayTags.map(item => (
          <span class="px-2 py-0.5 text-xs rounded bg-neutral-100 dark:bg-neutral-800 text-neutral-500 dark:text-neutral-400">
            {item}
          </span>
        ))}
      </div>
    )}
  </div>
</Component>
