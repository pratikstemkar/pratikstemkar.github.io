---
type Props = {
  title: string;
  href?: string;
  linkLabel?: string;
};

const { title, href, linkLabel = "See all" } = Astro.props;
---

<div class="flex flex-wrap items-center justify-between gap-y-2">
  <h2 class="flex items-center gap-2 text-lg font-semibold text-neutral-900 dark:text-white">
    <span class="inline-block size-2 rounded-full bg-gradient-to-br from-emerald-400 to-emerald-600"></span>
    {title}
  </h2>
  {
    href && (
      <a
        href={href}
        class="group inline-flex items-center gap-1 text-sm font-medium text-emerald-600 dark:text-emerald-400 hover:text-emerald-700 dark:hover:text-emerald-300 transition-colors duration-300"
      >
        {linkLabel}
        <svg
          xmlns="http://www.w3.org/2000/svg"
          width="14"
          height="14"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
          class="transition-transform duration-300 group-hover:translate-x-0.5"
        >
          <path d="M5 12h14" />
          <path d="m12 5 7 7-7 7" />
        </svg>
      </a>
    )
  }
</div>
