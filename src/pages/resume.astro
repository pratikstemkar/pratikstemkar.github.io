---
import PageLayout from "@layouts/PageLayout.astro";
import Container from "@components/Container.astro";
import { RESUME, SITE, OPEN_TO_WORK } from "@consts";
import { RESUME_DATA } from "@data/resume";

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "Person",
  name: SITE.NAME,
  url: Astro.site + "resume",
  email: SITE.EMAIL,
  jobTitle: "Software Engineer",
  knowsAbout: RESUME_DATA.skills.flatMap((c) => c.skills),
};
---

<PageLayout title={RESUME.TITLE} description={RESUME.DESCRIPTION}>
  <script is:inline type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  <Container>
    <div class="space-y-10">

      <!-- Hero -->
      <div class="animate">
        {
          OPEN_TO_WORK && (
            <div class="inline-flex items-center gap-2 px-3 py-1.5 rounded-full bg-purple-50 dark:bg-purple-900/30 border border-purple-200 dark:border-purple-700 text-purple-700 dark:text-purple-300 text-sm font-medium mb-4 print:hidden">
              <span class="relative flex h-2.5 w-2.5">
                <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-purple-400 opacity-75"></span>
                <span class="relative inline-flex rounded-full h-2.5 w-2.5 bg-purple-500"></span>
              </span>
              Open to Work
            </div>
          )
        }
        <h1 class="font-extrabold tracking-tight text-neutral-900 dark:text-white text-3xl mb-1">
          {SITE.NAME}
        </h1>
        <p class="text-lg font-medium text-emerald-600 dark:text-emerald-400">
          {RESUME_DATA.title}
        </p>
        <div class="w-16 h-1 bg-gradient-to-r from-emerald-500 to-emerald-400 rounded-full mt-4"></div>
      </div>

      <!-- Summary -->
      <section class="animate space-y-3">
        <h5 class="font-semibold text-neutral-900 dark:text-white flex items-center gap-2">
          <span class="w-2 h-2 rounded-full bg-emerald-500"></span>
          Summary
        </h5>
        <p class="text-neutral-600 dark:text-neutral-400 leading-relaxed">
          {RESUME_DATA.summary}
        </p>
      </section>

      <!-- PDF Viewer -->
      <section class="animate print:hidden">
        <div class="rounded-xl overflow-hidden border border-neutral-200 dark:border-neutral-700 shadow-lg">
          <div class="flex items-center justify-between px-5 py-3 bg-neutral-100 dark:bg-neutral-800 border-b border-neutral-200 dark:border-neutral-700">
            <div class="flex items-center gap-2 text-sm font-medium text-neutral-700 dark:text-neutral-300">
              <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M14.5 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V7.5L14.5 2z"/><polyline points="14 2 14 8 20 8"/></svg>
              Resume
            </div>
            <a href={RESUME_DATA.resumePdfUrl} download class="inline-flex items-center gap-1.5 px-3 py-1.5 text-xs font-medium rounded-lg bg-emerald-600 hover:bg-emerald-700 text-white transition-colors">
              <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="7 10 12 15 17 10"/><line x1="12" x2="12" y1="15" y2="3"/></svg>
              Download
            </a>
          </div>
          <iframe
            src={RESUME_DATA.resumePdfUrl}
            class="w-full h-[60vh] sm:h-[70vh] lg:h-[80vh]"
            title="Resume PDF"
          >
          </iframe>
        </div>
      </section>

      <!-- Bottom Download -->
      <div class="animate text-center pt-4 border-t border-neutral-200 dark:border-neutral-700 print:hidden">
        <a href={RESUME_DATA.resumePdfUrl} download class="inline-flex items-center gap-2 px-6 py-2.5 rounded-lg bg-emerald-600 hover:bg-emerald-700 text-white font-medium transition-colors">
          <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="7 10 12 15 17 10"/><line x1="12" x2="12" y1="15" y2="3"/></svg>
          Download Resume (PDF)
        </a>
      </div>

    </div>
  </Container>
</PageLayout>
