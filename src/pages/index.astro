---
import { getCollection } from "astro:content";
import Container from "@components/Container.astro";
import PageLayout from "@layouts/PageLayout.astro";
import ArrowCard from "@components/ArrowCard.astro";
import SectionHeading from "@components/SectionHeading.astro";
import { SITE, HOME, OPEN_TO_WORK, SOCIALS } from "@consts";

const blog = (await getCollection("blog"))
  .filter((post) => post.data.visible !== false)
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .slice(0, SITE.NUM_POSTS_ON_HOMEPAGE);

const projects = (await getCollection("projects"))
  .filter((project) => !project.data.draft)
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .slice(0, SITE.NUM_PROJECTS_ON_HOMEPAGE);

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "Person",
  name: SITE.NAME,
  url: Astro.site,
  sameAs: SOCIALS.map((social) => social.HREF),
  jobTitle: "Software Engineer · Distributed Systems · Databases · Agentic AI",
};
---

<PageLayout title={HOME.TITLE} description={HOME.DESCRIPTION}>
  <script is:inline type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  <Container>
    <div class="space-y-24">
      <!-- Hero -->
      <header class="relative">
        <div class="relative">
          <div
            class="animate-fade-up mb-2 flex flex-wrap items-center gap-x-3 gap-y-1"
          >
            <p class="text-lg text-neutral-500 dark:text-neutral-400">
              Hi there, I'm
            </p>
            {
              OPEN_TO_WORK && (
                <span class="inline-flex items-center gap-1.5 rounded-full border border-purple-200 bg-purple-50 px-3 py-1 text-xs font-medium text-purple-700 dark:border-purple-700 dark:bg-purple-900/30 dark:text-purple-300">
                  <span class="relative flex h-2 w-2">
                    <span class="absolute inline-flex h-full w-full animate-ping rounded-full bg-purple-400 opacity-75" />
                    <span class="relative inline-flex h-2 w-2 rounded-full bg-purple-500" />
                  </span>
                  Open to Work
                </span>
              )
            }
          </div>
          <h1
            class="hero-name animate-fade-up font-extrabold tracking-tight text-neutral-900 dark:text-white"
            style="animation-delay: 80ms"
          >
            Pratik Temkar <span class="inline-block animate-wave">👋🏻</span>
          </h1>
          <div class="animate-fade-up mt-3" style="animation-delay: 160ms">
            <p class="text-xl font-medium text-emerald-600 dark:text-emerald-400">
              Software Engineer · Distributed Systems · Databases · Agentic AI
            </p>
          </div>
          <div class="animate-fade-up mt-5 h-1 w-16 rounded-full bg-gradient-to-r from-emerald-500 to-emerald-400" style="animation-delay: 240ms"></div>

          <div class="animate-fade-up mt-7 flex flex-wrap gap-3" style="animation-delay: 320ms">
            <a
              href="/about"
              class="inline-flex items-center gap-2 rounded-full bg-emerald-600 px-5 py-2.5 text-sm font-medium text-white shadow-lg shadow-emerald-600/20 transition-all duration-300 hover:-translate-y-0.5 hover:bg-emerald-700"
            >
              About me
              <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M5 12h14" /><path d="m12 5 7 7-7 7" />
              </svg>
            </a>
            <a
              href="/blog"
              class="inline-flex items-center gap-2 rounded-full border border-neutral-200 bg-white px-5 py-2.5 text-sm font-medium text-neutral-700 transition-all duration-300 hover:-translate-y-0.5 hover:border-emerald-300 dark:border-neutral-700 dark:bg-neutral-800/60 dark:text-neutral-200"
            >
              Read the blog
            </a>
          </div>
        </div>
      </header>

      <!-- About snippet -->
      <section class="reveal">
        <p class="max-w-3xl text-lg leading-relaxed text-neutral-600 dark:text-neutral-300">
          I build distributed systems and backend architectures, and spend a lot
          of time with databases at scale. Lately I've been exploring agentic AI
          workflows and how LLM agents fit into real engineering work.
        </p>
      </section>

      <!-- Latest posts -->
      <section class="space-y-6">
        <div class="reveal">
          <SectionHeading title="Latest posts" href="/blog" linkLabel="See all posts" />
        </div>
        <ul class="reveal flex flex-col divide-y divide-neutral-100 dark:divide-neutral-800/60">
          {blog.map((post) => (
            <li>
              <ArrowCard entry={post} />
            </li>
          ))}
        </ul>
      </section>

      <!-- Projects -->
      <section class="space-y-6">
        <div class="reveal">
          <SectionHeading title="Recent projects" href="/projects" linkLabel="See all projects" />
        </div>
        <ul class="reveal flex flex-col divide-y divide-neutral-100 dark:divide-neutral-800/60">
          {projects.map((project) => (
            <li>
              <ArrowCard entry={project} />
            </li>
          ))}
        </ul>
      </section>

      <!-- Connect -->
      <section class="reveal space-y-4">
        <SectionHeading title="Let's connect" />
        <p class="max-w-prose text-neutral-600 dark:text-neutral-400">
          If you want to talk systems, databases, or agentic AI — reach out on
          social media or send me an email.
        </p>
        <ul class="flex flex-wrap gap-2">
          {
            SOCIALS.map((social) => (
              <li>
                <a
                  href={social.HREF}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="inline-flex items-center gap-1.5 rounded-full border border-neutral-200 bg-white px-4 py-2 text-sm text-neutral-600 transition-all duration-300 hover:-translate-y-0.5 hover:border-emerald-300 hover:text-emerald-600 dark:border-neutral-700 dark:bg-neutral-800/60 dark:text-neutral-300"
                >
                  {social.NAME}
                </a>
              </li>
            ))
          }
          <li>
            <a
              href={`mailto:${SITE.EMAIL}`}
              class="inline-flex items-center gap-1.5 rounded-full border border-neutral-200 bg-white px-4 py-2 text-sm text-neutral-600 transition-all duration-300 hover:-translate-y-0.5 hover:border-emerald-300 hover:text-emerald-600 dark:border-neutral-700 dark:bg-neutral-800/60 dark:text-neutral-300"
            >
              email
            </a>
          </li>
        </ul>
      </section>
    </div>
  </Container>
</PageLayout>
